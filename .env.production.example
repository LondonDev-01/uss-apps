# ============================================================
# USS Apps — Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in the values.
# Used by docker-compose.yml for the production stack.
# ============================================================

# ---------- Postgres ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_EN_PROD
POSTGRES_DB=uss_apps

# ---------- API (NestJS) ----------
DATABASE_URL=postgresql://postgres:CAMBIAR_EN_PROD@postgres:5432/uss_apps?schema=public
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET=CAMBIAR_EN_PROD
JWT_REFRESH_SECRET=CAMBIAR_EN_PROD

# Microsoft OAuth
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://tudominio.cl/api/v1/auth/microsoft/callback
AUTH_SUCCESS_REDIRECT=https://tudominio.cl/

# ---------- SPAs (build-time) ----------
# URL del API visible desde el navegador del usuario
VITE_API_URL=https://tudominio.cl/api/v1
