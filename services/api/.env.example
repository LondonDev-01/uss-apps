# PostgreSQL local (docker compose de dev — credenciales SOLO de desarrollo)
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/uss_apps?schema=public"

# Puerto del API
PORT=3001

# Microsoft OAuth (app multi-tenant registrada en tenant propio)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant USS — descubierto via endpoint publico de discovery (no requiere admin)
MICROSOFT_TENANT_ID=7a599002-001c-432c-846e-1ddca9f6b299
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/v1/auth/microsoft/callback

# JWT propios del ecosistema (dev — en prod van en el .env del VPS)
JWT_SECRET=dev-jwt-secret-cambiar-en-prod
JWT_REFRESH_SECRET=dev-refresh-secret-cambiar-en-prod

# Redirect post-login (hub en Fase C; dev apunta a horarios)
AUTH_SUCCESS_REDIRECT="http://localhost:3000/"
